{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Respawn",
  "version": "0.1.4",
  "identifier": "gg.respawn.browser",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Respawn",
    "category": "Utility",
    "shortDescription": "Respawn - The Gamers Browser",
    "longDescription": "Respawn, The Gamers Browser, is a lightweight Windows browser: hibernating tabs, Game Mode, per-tab logins, gaming sidebar, ad blocking, screen capture and a Discord translator.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "displayLanguageSelector": false
      }
    }
  }
}
