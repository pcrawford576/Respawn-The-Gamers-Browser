<?xml version="1.0" encoding="utf-8"?>
<!--
  Paste this into SignPath: Project "respawn" > Artifact configurations > default.
  GitHub hands SignPath a ZIP; every .exe inside it (Respawn.exe, then the
  installer) gets an Authenticode signature.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="*.exe">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
