<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <!-- Main browser column -->
    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Tab strip -->
        <LinearLayout
            android:id="@+id/tabBar"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@color/bg"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnSidebar"
                style="@style/Widget.AppCompat.ActionButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="Sidebar"
                android:src="@drawable/ic_sidebar" />

            <!-- Account bar: name of the current account ▾ (tap for the list,
                 swipe left/right or use the arrows to change tab). -->
            <ImageButton
                android:id="@+id/btnPrev"
                style="@style/Widget.AppCompat.ActionButton"
                android:layout_width="36dp"
                android:layout_height="44dp"
                android:contentDescription="Previous tab"
                android:src="@drawable/ic_back" />

            <LinearLayout
                android:id="@+id/accountBar"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:background="@drawable/address_bg"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="10dp">

                <TextView
                    android:id="@+id/accountName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:textColor="@color/text"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tabPosition"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textColor="@color/muted"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="▾"
                    android:textColor="@color/accent"
                    android:textSize="16sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnNext"
                style="@style/Widget.AppCompat.ActionButton"
                android:layout_width="36dp"
                android:layout_height="44dp"
                android:contentDescription="Next tab"
                android:src="@drawable/ic_next" />

            <ImageButton
                android:id="@+id/btnNewTab"
                style="@style/Widget.AppCompat.ActionButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="New tab"
                android:src="@drawable/ic_add" />
        </LinearLayout>

        <!-- Toolbar -->
        <LinearLayout
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@color/panel"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <ImageButton
                android:id="@+id/btnBack"
                style="@style/Widget.AppCompat.ActionButton"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:contentDescription="Back"
                android:src="@drawable/ic_back" />

            <ImageButton
                android:id="@+id/btnReload"
                style="@style/Widget.AppCompat.ActionButton"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:contentDescription="Reload"
                android:src="@drawable/ic_reload" />

            <AutoCompleteTextView
                android:id="@+id/address"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/address_bg"
                android:completionThreshold="1"
                android:dropDownVerticalOffset="6dp"
                android:hint="@string/address_hint"
                android:imeOptions="actionGo"
                android:inputType="textUri"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:selectAllOnFocus="true"
                android:singleLine="true"
                android:textColor="@color/text"
                android:textColorHint="@color/muted"
                android:textSize="14sp" />

            <ImageButton
                android:id="@+id/btnMenu"
                style="@style/Widget.AppCompat.ActionButton"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:contentDescription="Menu"
                android:src="@drawable/ic_more" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progress"
            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:indeterminate="false"
            android:max="100"
            android:progressTint="@color/accent"
            android:progressBackgroundTint="@color/bg" />

        <!-- Every tab's WebView lives here; only the active one is visible. -->
        <FrameLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>

    <!-- Gaming sidebar (slide in from the left) -->
    <LinearLayout
        android:id="@+id/sidebar"
        android:layout_width="340dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/panel"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/panelButtons"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal" />

        <FrameLayout
            android:id="@+id/panelContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>
</androidx.drawerlayout.widget.DrawerLayout>
